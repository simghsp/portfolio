# Public absolute URL of the deployed site — used for metadata, Open Graph
# images, and the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Resend API key for the contact form (https://resend.com — free tier).
# Without this set, the contact form still validates and rate-limits
# submissions, but shows a "not fully wired up yet" message instead of
# sending an email, so it never fails silently.
RESEND_API_KEY=

# Where contact form submissions are delivered. Defaults to the address in
# src/lib/data.ts if unset.
CONTACT_TO_EMAIL=
